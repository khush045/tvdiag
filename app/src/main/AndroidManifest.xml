<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV hardware: no touchscreen, leanback optional so it also installs on emulators/phones. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      Read-only. Needed on API 30+ so the Developer Options Doctor can see which Settings
      packages and OEM packages exist and what a Settings intent resolves to.
      See docs/PERMISSIONS.md. No INTERNET permission is requested.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      Declared only so the Recovery Center can detect whether the system granted it. A normal
      sideloaded app will NOT receive it, and the reboot buttons then stay disabled.
    -->
    <uses-permission android:name="android.permission.REBOOT" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/banner"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
